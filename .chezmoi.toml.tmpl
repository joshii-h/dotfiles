{{- $distro := "" -}}
{{- if stat "/etc/os-release" -}}
{{-   range (split "\n" (include "/etc/os-release")) -}}
{{-     if hasPrefix "ID=" . -}}
{{-       $distro = trimPrefix "ID=" . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

# Quelle wie alle anderen Repos unter ~/Projects (XDG_PROJECTS_DIR)
sourceDir = "~/Projects/dotfiles"

[data]
    distro = {{ $distro | quote }}
