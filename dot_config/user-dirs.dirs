# XDG-Benutzerordner (xdg-user-dirs, https://wiki.archlinux.org/title/XDG_user_directories)
# Englische Namen auf beiden Rechnern; Code liegt in ~/Projects (XDG_PROJECTS_DIR,
# seit xdg-user-dirs 0.19 Standard). Von chezmoi verwaltet – Änderungen im Repo machen.
XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_TEMPLATES_DIR="$HOME/Templates"
XDG_PUBLICSHARE_DIR="$HOME/Public"
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_MUSIC_DIR="$HOME/Music"
XDG_PICTURES_DIR="$HOME/Pictures"
XDG_VIDEOS_DIR="$HOME/Videos"
XDG_PROJECTS_DIR="$HOME/Projects"
