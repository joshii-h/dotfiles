[Desktop Entry]
# Überschreibt /etc/xdg/autostart: nur unter Plasma starten. Unter niri
# braucht es die Brücke nicht (Bildschirmfreigabe läuft über das Portal).
Type=Application
Name=Xwayland Video Bridge
Exec=xwaylandvideobridge
Icon=org.kde.xwaylandvideobridge
NoDisplay=true
StartupNotify=false
X-KDE-autostart-phase=2
OnlyShowIn=KDE;
