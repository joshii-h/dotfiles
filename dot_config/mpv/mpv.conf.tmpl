# mpv – Battlestation (Radeon RX 7900, niri)
# Bild: moderner Renderer + Hardware-Dekodierung über VA-API
vo=gpu-next
gpu-api=vulkan
hwdec=vaapi
profile=high-quality

# uosc ersetzt die eingebaute Bedienleiste (Empfehlung aus der uosc-Doku)
osc=no
osd-bar=no
border=no

# Komfort
keep-open=yes
save-position-on-quit=yes
slang=de,ger,deu,en,eng
alang=de,ger,deu,en,eng
screenshot-directory=~/Pictures/Screenshots

{{- if eq .distro "gentoo" }}

# Akzentfarben der uosc-Leiste aus dem Hintergrundbild (DMS/matugen)
include=~~/dms-uosc.conf
{{- end }}
