# zathura – Farben aus dem Hintergrundbild (matugen/DMS), eingebunden in zathurarc
set default-bg "{{colors.surface.dark.hex}}"
set default-fg "{{colors.on_surface.dark.hex}}"
set statusbar-bg "{{colors.surface_container.dark.hex}}"
set statusbar-fg "{{colors.on_surface.dark.hex}}"
set inputbar-bg "{{colors.surface_container_high.dark.hex}}"
set inputbar-fg "{{colors.on_surface.dark.hex}}"
set notification-bg "{{colors.surface_container_high.dark.hex}}"
set notification-fg "{{colors.on_surface.dark.hex}}"
set notification-error-bg "{{colors.error_container.dark.hex}}"
set notification-error-fg "{{colors.on_error_container.dark.hex}}"
set completion-bg "{{colors.surface_container.dark.hex}}"
set completion-fg "{{colors.on_surface.dark.hex}}"
set completion-highlight-bg "{{colors.primary_container.dark.hex}}"
set completion-highlight-fg "{{colors.on_primary_container.dark.hex}}"
set highlight-color "rgba(255,172,236,0.35)"
set highlight-active-color "{{colors.primary.dark.hex}}"
set index-bg "{{colors.surface.dark.hex}}"
set index-fg "{{colors.on_surface.dark.hex}}"
set index-active-bg "{{colors.primary_container.dark.hex}}"
set index-active-fg "{{colors.on_primary_container.dark.hex}}"
set recolor-lightcolor "{{colors.surface.dark.hex}}"
set recolor-darkcolor "{{colors.on_surface.dark.hex}}"
