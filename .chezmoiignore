# sysup-Helfer sind Gentoo-spezifisch (emerge, eclean-kernel, grub-mkconfig).
{{- if ne .distro "gentoo" }}
.local/bin/sysup-shutdown
.local/bin/emerge-mon
{{- end }}

# AI-Stack (ROCm, Hermes) und Proton-GE laufen nur im Gentoo-sysup.
{{- if ne .distro "gentoo" }}
ai/**
.local/bin/proton-ge-update
{{- end }}

# plasmashell-Watchdog nur ohne systemd noetig (dort macht es
# plasma-plasmashell.service mit Restart=on-failure).
{{- if ne .distro "gentoo" }}
.local/bin/plasmashell-watchdog
.config/autostart/plasmashell-watchdog.desktop
{{- end }}

