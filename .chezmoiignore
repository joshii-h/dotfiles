# sysup-Helfer sind Gentoo-spezifisch (emerge, eclean-kernel, grub-mkconfig).
{{- if ne .distro "gentoo" }}
.local/bin/sysup-shutdown
.local/bin/emerge-mon
{{- end }}

# AI-Stack (ROCm, Hermes) und Proton-GE laufen nur im Gentoo-sysup.
{{- if ne .distro "gentoo" }}
.local/share/ai/**
.local/bin/proton-ge-update
{{- end }}

# Hz-Automatik (Desktop 60 Hz, Spiele volle Hz) ist auf die Monitore der
# Battlestation zugeschnitten (DP-1 165 Hz, HDMI-A-2 90 Hz) -> nur Gentoo.
{{- if ne .distro "gentoo" }}
.local/bin/refresh-switch
.local/bin/refresh-switch-toggle
.config/autostart/refresh-switch.desktop
.local/share/applications/refresh-switch-toggle.desktop
{{- end }}

# AI-Stack: nur die Skripte/Configs versionieren, nicht die schweren
# Laufzeit-/Modell-/Clone-Verzeichnisse und generierten Artefakte.
.local/share/ai/venv/**
.local/share/ai/ComfyUI/**
.local/share/ai/odysseus/**
.local/share/ai/hermes-agent/**
.local/share/ai/models/**
.local/share/ai/.miopen/**
.local/share/ai/media-mcp/outputs/**
.local/share/ai/incoming/**
.local/share/ai/*.log
.local/share/ai/*.png
.local/share/ai/*.wav

# niri + Dux Shell (DMS) läuft auf beiden Rechnern: Config (Monitore je
# Distro in config.kdl.tmpl), Portale, matugen, GTK/Qt-Look, Schriften,
# Dateimanager-Aktionen und dms-/uosc-update werden überall verwaltet.
# Nur Battlestation-Hardware bleibt Gentoo: RGB (OpenRazer/OpenRGB),
# Geräteakku-Plugin, GRUB-Theme, Lesezeichen und portage-Leichen.
{{- if ne .distro "gentoo" }}
.config/dms/plugins/**
.config/autostart/openrazer-daemon.desktop
.config/autostart/rgb-sync.desktop
.local/bin/rgb-sync
.local/bin/rgb-sync-messen
.config/gtk-3.0/bookmarks
.local/bin/grub-theme
.config/sysup/**
{{- end }}
# Plymouth-Startbild (Fedora-Logo, dracut) bisher nur auf dem Laptop
{{- if ne .distro "fedora" }}
.local/bin/startbild
{{- end }}
# Von DMS erzeugt (dms setup, Farbschema) – nicht von chezmoi verwalten
.config/niri/dms/**
.config/nvim/colors/dms.lua
.config/nvim/lua/lualine/themes/dms.lua

**/__pycache__
