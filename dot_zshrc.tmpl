# Path (consolidated - no need for .deno/env and .local/bin/env)
export PATH="$HOME/.local/bin:$HOME/.deno/bin:$HOME/.juliaup/bin:$PATH"
export FPATH="$HOME/completions:$FPATH"

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
HYPHEN_INSENSITIVE="true"
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 13
ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="dd.mm.yyyy"
plugins=(git)

# Cache compinit - only regenerate once per day
zstyle ':omz:alpha:lib:completion' caching yes
source $ZSH/oh-my-zsh.sh
{{- if eq .distro "fedora" }}

sysup() {
  if [[ "$1" == "-r" || "$1" == "--release" ]]; then
    _sysup_release "$2"
    return $?
  fi
  command sudo -v || return 1
  ssh-add -l &>/dev/null || { ssh-add ~/.ssh/id_ed25519 || return 1; }
  setopt LOCAL_OPTIONS NO_NOTIFY NO_MONITOR
  local -a names=(dnf flatpak rustup deno npm dotfiles noson claude)
  local -a logs pids
  for n in $names; do logs+=($(mktemp)); done
  local start=$SECONDS
  command sudo dnf up -y &>"${logs[1]}" &
  pids+=($!)
  setsid flatpak upgrade -y &>"${logs[2]}" &
  pids+=($!)
  rustup update &>"${logs[3]}" &
  pids+=($!)
  deno upgrade &>"${logs[4]}" &
  pids+=($!)
  command sudo npm update -g --fund=false --loglevel=error &>"${logs[5]}" &
  pids+=($!)
  chezmoi update --no-tty &>"${logs[6]}" &
  pids+=($!)
  {
    local latest=$(curl -sf "https://api.github.com/repos/janbar/noson-app/releases/latest" | python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'])")
    local current=$(cat ~/Applications/.noson-version 2>/dev/null)
    if [[ -n "$latest" && "$latest" != "$current" ]]; then
      curl -Lf -o ~/Applications/noson.AppImage "https://github.com/janbar/noson-app/releases/download/${latest}/noson-${latest}-x86_64.AppImage" \
        && chmod +x ~/Applications/noson.AppImage \
        && echo "$latest" > ~/Applications/.noson-version \
        && echo "Updated: $current -> $latest"
    else
      echo "noson ${current:-unknown} is up to date"
    fi
  } &>"${logs[7]}" &
  pids+=($!)
  distrobox enter claude-desktop -- sh -c 'sudo apt-get update -q && sudo apt-get upgrade -y' &>"${logs[8]}" &
  pids+=($!)
  local lines=$(( ${#names} + 2 ))
  local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0 drawn=0
  tput civis 2>/dev/null
  trap 'tput cnorm 2>/dev/null' INT TERM
  while true; do
    local all_done=1
    for j in {1..${#pids}}; do
      kill -0 ${pids[$j]} 2>/dev/null && all_done=0 && break
    done
    (( all_done )) && break
    (( drawn )) && printf "\033[${lines}A"
    local elapsed=$((SECONDS - start))
    local maxw=$(( COLUMNS - 16 ))
    local s=${spin:$((i%${#spin})):1}
    printf "\033[K\n"
    printf "\033[K  \033[1;33m%s\033[0m  \033[1msysup\033[0m  \033[2m%dm%02ds\033[0m\n" \
      "$s" $((elapsed/60)) $((elapsed%60))
    for j in {1..${#pids}}; do
      local last=$(tail -1 "${logs[$j]}" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | tr -d '\r')
      if kill -0 ${pids[$j]} 2>/dev/null; then
        printf "\033[K  \033[33m●\033[0m  %-8s \033[2m%s\033[0m\n" "${names[$j]}" "${${last:-(starting...)}:0:$maxw}"
      else
        printf "\033[K  \033[32m✓\033[0m  %-8s \033[2mdone\033[0m\n" "${names[$j]}"
      fi
    done
    printf "\033[K"
    drawn=1; ((i++)); sleep 0.5
  done
  tput cnorm 2>/dev/null
  trap - INT TERM
  if (( drawn )); then
    printf "\033[${lines}A"
    for _ in {1..$lines}; do printf "\033[K\n"; done
    printf "\033[${lines}A"
  fi
  wait
  for j in {1..${#names}}; do
    printf "\n\033[1;36m--- %s ---\033[0m\n" "${names[$j]}"; cat "${logs[$j]}"
  done
  rm -f "${logs[@]}"
  printf "\n\033[1;32m✓ Done in %ds\033[0m\n" "$((SECONDS - start))"
}

# garantierter Cleanup des temp. Swap-Puffers ($1 = pfad); idempotent
_sysup_relcleanup() {
  [[ -n "$1" && -e "$1" ]] || return 0
  command sudo swapoff "$1" 2>/dev/null
  command sudo rm -f "$1" && printf "\033[2m  temporärer Swap-Puffer entfernt\033[0m\n"
}

# Fedora Release-Upgrade (online distro-sync + Swap-Puffer gegen dnf5-RAM-Peak).
# Aufruf: sysup -r [zielversion]
_sysup_release() {
  emulate -L zsh
  local current target reply swapfile=/swapfile.sysup avail
  current=$(rpm -E %fedora)
  target="${1:-$((current + 1))}"

  printf "\033[1;36m▶ Fedora Release-Upgrade (online): %s → %s\033[0m\n" "$current" "$target"
  if (( target <= current )); then
    printf "\033[1;31m✗ Zielversion %s ist nicht neuer als die aktuelle (%s).\033[0m\n" "$target" "$current"
    return 1
  fi
  command sudo -v || return 1
  trap '_sysup_relcleanup "$swapfile"; trap - INT TERM' INT TERM

  # 0/4  Swap-Puffer – fängt den dnf5-Speicher-Peak ab (der hat F43→44 fast zerlegt)
  printf "\n\033[1;33m0/4\033[0m  Temporären 24G-Swap-Puffer anlegen…\n"
  avail=$(df --output=avail -BG / | tail -1 | tr -dc '0-9')
  [[ -e $swapfile ]] && { command sudo swapoff "$swapfile" 2>/dev/null; command sudo rm -f "$swapfile"; }
  if (( ${avail:-0} < 30 )); then
    printf "  \033[33m! nur %sG frei – überspringe Swap-Puffer (zram bleibt aktiv)\033[0m\n" "${avail:-0}"
  elif { command sudo btrfs filesystem mkswapfile --size 24g "$swapfile" 2>/dev/null \
         || { command sudo install -m600 /dev/null "$swapfile" && { command sudo chattr +C "$swapfile" 2>/dev/null; command sudo fallocate -l 24G "$swapfile" && command sudo mkswap "$swapfile" >/dev/null; }; }; } \
       && command sudo swapon "$swapfile" 2>/dev/null; then
    printf "  \033[32m✓\033[0m Swap-Puffer aktiv (24G)\n"
  else
    printf "  \033[33m! Swap-Puffer fehlgeschlagen (zram bleibt) – fahre fort\033[0m\n"
    command sudo rm -f "$swapfile"
  fi

  # 1/4  aktuelles System voll aktualisieren
  printf "\n\033[1;33m1/4\033[0m  System vollständig aktualisieren…\n"
  command sudo dnf upgrade --refresh -y \
    || { printf "\033[1;31m✗ Update fehlgeschlagen – abgebrochen.\033[0m\n"; _sysup_relcleanup "$swapfile"; trap - INT TERM; return 1; }

  # 2/4  Online-Release-Upgrade – dnf zeigt den Plan (inkl. Entfernungen), du bestätigst
  printf "\n\033[1;33m2/4\033[0m  Release-Upgrade auf Fedora %s — Plan prüfen & bestätigen:\n" "$target"
  free -h | awk 'NR==1 || /Mem:|Swap:/'
  command sudo dnf distro-sync --releasever="$target" --allowerasing \
    || { printf "\033[1;31m✗ Abgebrochen/fehlgeschlagen.\033[0m  Bei Duplikaten (nach Abbruch) notfalls dnf4:\n     sudo dnf4 distro-sync --releasever=%s --setopt='*.repo_gpgcheck=0' --allowerasing\n" "$target"; _sysup_relcleanup "$swapfile"; trap - INT TERM; return 1; }

  _sysup_relcleanup "$swapfile"
  trap - INT TERM

  # 3/4  Konsistenz prüfen
  printf "\n\033[1;33m3/4\033[0m  Konsistenz prüfen (dnf check)…\n"
  command sudo dnf check && printf "  \033[32m✓ keine Probleme\033[0m\n" \
    || printf "  \033[33m! dnf check meldet Punkte (siehe oben) – vor Reboot ansehen\033[0m\n"

  # 4/4  Reboot (Kernel-akmods bauen beim nächsten Boot neu)
  printf "\n\033[1;32m✓ Fedora %s angewendet.\033[0m\n" "$target"
  printf "\033[1;33m4/4\033[0m  Jetzt neu starten? [j/N] "
  read -k 1 reply; echo
  [[ "$reply" == [jJyY] ]] && command systemctl reboot \
    || printf "Später neu starten mit:  \033[1msystemctl reboot\033[0m\n"
}
{{- end }}
{{- if eq .distro "gentoo" }}

# emerge --sync scheitert sporadisch, weil in der Rotation von
# rsync.europe.gentoo.org einzelne Hosts eine inkonsistente Manifest-Kette
# ausliefern: die signierte Manifest ist neuer als das metadata/Manifest.gz,
# das derselbe Host serviert (2026-09-11 an 78.128.80.69 verifiziert).
# Ein zweiter Versuch landet praktisch immer auf einem gesunden Mirror.
# Klappt auch der nicht, laeuft die Update-Kette trotzdem weiter: die
# Quarantaene laesst den lokalen Tree unangetastet, er ist also weiter
# benutzbar - nur eben eine Generation alt.
# Die Ausgabe laeuft live ins Log, damit die Statuszeile waehrend des Syncs
# nicht minutenlang stillsteht. Ein gescheiterter erster Versuch endet mit
# einem Marker, an dem _sysup_emerge_summary dessen Fehlerzeilen verwirft.
_sysup_sync() {
  local try
  for try in 1 2; do
    printf ">>> Syncing repositories (Versuch %d)...\n" $try
    if command sudo emerge --sync 2>&1; then
      (( try > 1 )) && printf " * IMPORTANT: emerge --sync brauchte %d Versuche (defekter Mirror in der Rotation)\n" $try
      return 0
    fi
    (( try < 2 )) && printf "__SYSUP_SYNC_RETRY__\n"
  done
  printf " * IMPORTANT: emerge --sync nach 2 Versuchen fehlgeschlagen - Portage-Tree bleibt eine Generation alt, @world läuft trotzdem weiter\n"
  return 0
}

# Kompakter emerge-Report statt des kompletten Build-Logs. Was wirklich
# installiert/entfernt wurde, kommt aus ">>> Installing"/">>> Unmerging"
# (ueberlebt damit auch Teilabbrueche), die Alt->Neu-Versionen und Flags
# aus der Portage-Planungstabelle ("[ebuild   U  ] ..."). Volles Log siehe
# ~/.cache/sysup/.
_sysup_emerge_summary() {
  local log=$1
  awk -v logpath="$log" '
    function atomsplit(s) {
      sub(/::.*$/, "", s); sub(/:.*$/, "", s); sub(/\.+$/, "", s)
      A_name = s; A_ver = ""
      if (match(s, /-[0-9][^-]*(-r[0-9]+)?$/)) {
        A_name = substr(s, 1, RSTART - 1)
        A_ver  = substr(s, RSTART + 1)
      }
    }
    # Bei \r-Fortschrittszeilen zaehlt nur, was ein Terminal zuletzt zeigen wuerde.
    function obs_add(atom,   f, prio) {
      f = ofile; sub(/:$/, "", f); sub(/.*\/package\./, "", f); sub(/\{,accept_\}/, "accept_", f)
      prio = (ocat == "nicht installiert") ? 3 : (ocat == "ungültig") ? 2 : 1
      if (!(atom in oprio)) oorder[++no_obs] = atom
      if (prio > oprio[atom]) { oprio[atom] = prio; olabel[atom] = ocat " (" f ")" }
    }
    { gsub(/\033\[[0-9;]*[a-zA-Z]/, ""); sub(/.*\r/, "") }

    # Fehlerzeilen eines gescheiterten ersten Sync-Versuchs verwerfen - der
    # zweite Versuch hat sie ueberholt (siehe _sysup_sync).
    /^>>> Syncing repositories \(Versuch / { nf_mark = nf; nn_mark = nn; next }
    /^__SYSUP_SYNC_RETRY__/ {
      for (i = nf_mark + 1; i <= nf; i++) delete fseen[fail[i]]
      for (i = nn_mark + 1; i <= nn; i++) delete seen[note[i]]
      nf = nf_mark; nn = nn_mark
      next
    }

    # Letzter Fortschrittsstand: bei einem Abbruch zeigt er, wie viel vom Plan
    # ueberhaupt gebaut wurde (am 2026-09-15 blieben 61 von 124 Paketen liegen,
    # der Report nannte nur das eine fehlgeschlagene).
    /^>>> Jobs: [0-9]+ of [0-9]+ complete/ {
      split($0, w, " "); j_done = w[3] + 0; j_total = w[5] + 0
      next
    }

    /^\[(ebuild|binary)/ {
      ci    = index($0, "]")
      inner = substr($0, 2, ci - 2)
      rest  = substr($0, ci + 1)
      fl = inner; sub(/^ *(ebuild|binary) */, "", fl); gsub(/ /, "", fl)
      sub(/^ +/, "", rest)
      split(rest, f, " ")
      atomsplit(f[1])
      key = A_name "-" A_ver
      flag[key] = fl
      if (match(rest, /\[[0-9][^]]*\]/)) {
        o = substr(rest, RSTART + 1, RLENGTH - 2)
        sub(/::.*$/, "", o); sub(/:.*$/, "", o); sub(/ .*$/, "", o)
        oldv[key] = o
      }
      next
    }

    /^>>> Installing / {
      if ($NF !~ /\//) next
      atomsplit($NF)
      key = A_name "-" A_ver
      fg = flag[key]
      sym = "*"; col = "0"
      if      (fg ~ /^N/) { sym = "+"; col = "32"; n_new++ }
      else if (fg ~ /D/)  { sym = "↓"; col = "35"; n_down++ }
      else if (fg ~ /U/)  { sym = "↑"; col = "36"; n_up++ }
      else if (fg ~ /R/)  { sym = "⟳"; col = "33"; n_re++ }
      else               { n_other++ }
      ver = (oldv[key] != "") ? oldv[key] " → " A_ver : A_ver
      out[++no] = sprintf("    \033[%sm%s\033[0m %-42s \033[2m%s\033[0m", col, sym, A_name, ver)
      next
    }

    /^>>> Unmerging / {
      if ($NF !~ /\//) next
      atomsplit($NF)
      n_rm++
      gone[++ng] = sprintf("    \033[31m−\033[0m %-42s \033[2m%s\033[0m", A_name, A_ver)
      next
    }

    /^Removing / { kern[++nk] = $0; next }
    /IMPORTANT:/ {
      line = $0; sub(/^[ *]+/, "", line)
      if (!seen[line]++) note[++nn] = line
      next
    }
    # Von Portage uebersprungene Updates (unerfuellte oder maskierte
    # Abhaengigkeit) brechen nichts ab: als Warnung mit Paket und Grund melden
    # statt als drei nichtssagende "!!!"-Zeilen unter "Fehler".
    /^!!! The following update has been skipped/ {
      if (cur_skip != "") { k = cur_skip " (unerfüllte Abhängigkeit)"; if (!sseen[k]++) skip[++ns] = k }
      skipping = 1; cur_skip = ""
      next
    }
    skipping && cur_skip == "" && /^[a-z0-9-]+\/[^ ]+/ { cur_skip = $1; next }
    /^!!! All ebuilds that could satisfy "/ {
      dep = $0; sub(/^[^"]*"/, "", dep); sub(/".*$/, "", dep)
      k = (cur_skip != "" ? cur_skip : "?") " (braucht " dep ", maskiert)"
      if (!sseen[k]++) skip[++ns] = k
      skipping = 0; cur_skip = ""
      next
    }
    /^!!! One of the following masked packages is required/ { next }
    /!!!|^>>> Failed to emerge|^ \* ERROR: .* failed|returned code = [1-9]/ {
      line = $0
      if (match(line, /!!!/)) line = substr(line, RSTART)
      sub(/^ +/, "", line)
      if (!fseen[line]++ && nf < 12) fail[++nf] = line
      next
    }
    # eix-test-obsolete: Funde je Paket sammeln (nicht installiert > ungueltig >
    # ueberfluessig), die Legende der Overlays und Statuszeilen ignorieren.
    /^__SYSUP_OBSOLETE_BEGIN__/ { obs = 1; next }
    /^__SYSUP_OBSOLETE_END__/   { obs = 0; next }
    obs {
      if (/^Non-matching or empty entries in /) { ocat = "ungültig"; ofile = $NF }
      else if (/^Redundant in /)               { ocat = "überflüssig"; ofile = $NF }
      else if (/^Not installed but in /)       { ocat = "nicht installiert"; ofile = $NF }
      else if (/^(No |Skipping |Found |All |The names|--$)/) ocat = ""
      else if (ocat != "" && /^\[[A-Z]\] /)       obs_add($2)
      else if (ocat == "ungültig" && NF && !/^\[[0-9]+\] "/ && !/^\.\.\. /) obs_add($1)
      next
    }
    /^__SYSUP_STAGE=/ { stage = substr($0, 15); next }
    /^__SYSUP_RC=/ { rc = substr($0, 12) + 0; rc_seen = 1 }

    END {
      hdr = ""
      if (n_up)    hdr = hdr sprintf("\033[36m↑ %d Updates\033[0m  ", n_up)
      if (n_new)   hdr = hdr sprintf("\033[32m+ %d neu\033[0m  ", n_new)
      if (n_re)    hdr = hdr sprintf("\033[33m⟳ %d Rebuilds\033[0m  ", n_re)
      if (n_down)  hdr = hdr sprintf("\033[35m↓ %d Downgrades\033[0m  ", n_down)
      if (n_other) hdr = hdr sprintf("%d sonstige  ", n_other)
      if (n_rm)    hdr = hdr sprintf("\033[31m− %d entfernt\033[0m", n_rm)
      if (hdr == "") hdr = "\033[2mkeine Paketänderungen\033[0m"
      printf "  %s\n", hdr
      for (i = 1; i <= no; i++) print out[i]
      for (i = 1; i <= ng; i++) print gone[i]
      for (i = 1; i <= nk; i++) printf "    \033[2m%s\033[0m\n", kern[i]
      for (i = 1; i <= nn; i++) printf "  \033[33m!\033[0m %s\n", note[i]
      if (cur_skip != "") { k = cur_skip " (unerfüllte Abhängigkeit)"; if (!sseen[k]++) skip[++ns] = k }
      for (i = 1; i <= ns; i++) printf "  \033[33m⚠ Update übersprungen:\033[0m %s\n", skip[i]
      if (no_obs) {
        printf "  \033[33m⚠ %d Leichen in /etc/portage\033[0m \033[2m(nur Hinweis, Details: eix-test-obsolete)\033[0m\n", no_obs
        for (i = 1; i <= no_obs; i++) printf "    %-42s \033[2m%s\033[0m\n", oorder[i], olabel[oorder[i]]
      }
      if (nf) {
        printf "  \033[1;31m✗ Fehler:\033[0m\n"
        for (i = 1; i <= nf; i++) printf "    %s\n", fail[i]
      }
      # Nur bei Abbruch: fuer erfolgreiche Laeufe ist nicht belegt, dass die
      # letzte Jobs-Zeile immer "N of N" lautet - keine Fehlalarme.
      if ((rc != 0 || !rc_seen) && j_total && j_done < j_total)
        printf "  \033[1;33m⚠ nur %d von %d geplanten Paketen gebaut, %d nicht\033[0m\n", j_done, j_total, j_total - j_done
      if (!rc_seen && (stage != "" || j_total))
        printf "  \033[1;31m✗ emerge-Kette nicht regulär beendet (kein Exit-Code im Log - abgeschossen?)\033[0m\n"
      if (rc != 0) {
        # Die Kette bricht beim ersten Fehler ab (&&) - alles danach lief nicht.
        if      (stage == "world")    skipped = "depclean, eclean-kernel"
        else if (stage == "depclean") skipped = "eclean-kernel"
        else                          skipped = ""
        if (stage != "") printf "  \033[1;31m✗ emerge-Kette abgebrochen in Stufe %s (Exit-Code %d)\033[0m\n", stage, rc
        else             printf "  \033[1;31m✗ emerge-Kette endete mit Exit-Code %d\033[0m\n", rc
        if (skipped != "") printf "    übersprungen: %s\n", skipped
      }
      printf "  \033[2mvolles Log: %s\033[0m\n", logpath
    }
  ' "$log"
}

# Lock fuer sysup-shutdown: erste Zeile "boot <boot_id>", dann je Prozess
# "<pid> <starttime>" (Feld 22 aus /proc/<pid>/stat). Nur ein Eintrag mit
# gleicher Boot-ID UND gleicher Startzeit gilt als lebend - ~/.cache liegt auf
# btrfs und ueberlebt Reboots, und PIDs laufen hier nach ~28 h Uptime ueber;
# eine blosse PID in einem alten Lock koennte sonst einen fremden Prozess
# treffen und sysup dauerhaft blockieren.
_sysup_pidstart() {
  [[ -r /proc/$1/stat ]] || return 1
  local st=$(</proc/$1/stat)
  st=${st##*\) }            # comm kann Leerzeichen/Klammern enthalten
  print -r -- ${${=st}[20]}
}

# Schreibt die noch lebenden unter den uebergebenen PIDs in den Lock; lebt
# keine mehr, verschwindet er. Wird mit expliziten PIDs aufgerufen, weil der
# Funktions-EXIT-Trap erst nach dem Scope laeuft und die Locals dann weg sind.
_sysup_lock_update() {
  local lock=$1 p st; shift
  local -a entries=()
  for p; do st=$(_sysup_pidstart $p) && entries+=("$p $st"); done
  if (( $#entries )); then
    print -l "boot $(</proc/sys/kernel/random/boot_id)" $entries >| $lock
  else
    rm -f $lock
  fi
}

# Gibt die PIDs eines Locks aus, die noch wirklich zu diesem Lauf gehoeren.
_sysup_lock_live() {
  local lock=$1 line
  [[ -r $lock ]] || return 0
  local -a l=(${(f)"$(<$lock)"}) w
  [[ ${l[1]} == "boot $(</proc/sys/kernel/random/boot_id)" ]] || return 0
  for line in ${l[2,-1]}; do
    w=(${=line})
    [[ ${w[1]} == <-> && -n ${w[2]} && $(_sysup_pidstart ${w[1]}) == ${w[2]} ]] && print ${w[1]}
  done
}

sysup() {
  # sudo -v fragt hier trotz NOPASSWD nach dem Passwort: sudoers hat fuer %wheel
  # zusaetzlich eine Regel MIT Passwort, und -v prueft alle passenden Regeln.
  # sudo -n true genuegt als Vorab-Check und fragt nur, wenn wirklich noetig.
  command sudo -n true 2>/dev/null || command sudo -v || return 1
  # NO_BG_NICE: sonst liefen flatpak/chezmoi/ai mit nice +5 (emerge regelt
  # seine Prioritaet selbst ueber PORTAGE_NICENESS).
  setopt LOCAL_OPTIONS LOCAL_TRAPS NO_NOTIFY NO_MONITOR NO_BG_NICE
  local -a names=(emerge flatpak dotfiles proton-ge ai)
  # Das emerge-Log und die komplette Zusammenfassung bleiben liegen (je die
  # letzten 10 Laeufe): nach sysup-shutdown ist das Terminal weg, ohne
  # gespeicherte Zusammenfassung blieben Fehler von flatpak/ai/proton unsichtbar.
  local logdir=$HOME/.cache/sysup stamp=$(date +%Y%m%d-%H%M%S)
  mkdir -p $logdir
  # Die Job-Logs liegen neben dem emerge-Log (nicht in mktemp): wird die
  # Anzeige verlassen, bleiben sie so fuer die Fehlersuche erhalten.
  local -a logs=($logdir/emerge-$stamp.log) pids
  for n in ${names[2,-1]}; do logs+=($logdir/$n-$stamp.log); done
  local summary=$logdir/summary-$stamp.txt start=$SECONDS
  # Lock fuer sysup-shutdown: Shell-PID + PIDs aller Jobs. Bei regulaerem Ende
  # verschwindet er erst nach der gespeicherten Zusammenfassung.
  local lock=$logdir/sysup.lock
  # Laeuft schon ein sysup - auch ein verlassener, dessen Jobs noch arbeiten?
  # Dann dessen Lock nicht ueberschreiben: sein EXIT-Trap haelt unsere PIDs fuer
  # tot und wuerde unseren Lock spaeter loeschen.
  local -a live=($(_sysup_lock_live $lock))
  if (( $#live )); then
    print -P "%F{red}✗ sysup läuft bereits%f (PIDs: $live) - Lock: $lock"
    return 1
  fi
  _sysup_lock_update $lock $$
  trap "_sysup_lock_update ${(q)lock}" EXIT
  # Strg+C/TERM verlassen nur die Anzeige, die Jobs laufen weiter; gezielt
  # abbrechen nur per "sudo kill" (emerge nie mitten im Merge - das hat am
  # 2026-09-15 einen Portage-Deadlock ausgeloest). Ohne eigenen Trap bricht zsh
  # die Funktion ab, ohne den EXIT-Trap auszufuehren, und der Lock bliebe mit
  # lebender Shell-PID stehen. Der Trap setzt nur ein Flag, das die Schleife
  # jeden Takt prueft: ein return direkt im Trap ging verloren, wenn das Signal
  # waehrend einer $(…)-Substitution kam. Der always-Block gibt den Lock auch
  # nach fatalen Fehlern frei (dort ueberspringt zsh den EXIT-Trap); der
  # EXIT-Trap selbst bleibt fuer SIGHUP beim Schliessen des Terminals.
  local interrupted=0
  trap 'interrupted=1' INT TERM
  {
    # Alle Jobs laufen per setsid in einer eigenen Session (sonst bekaeme emerge
    # beim Schliessen des Terminals das SIGHUP und braeche mitten im Merge ab)
    # und werden mit &! sofort disowned: nach Strg+C ist MONITOR wieder an, und
    # zsh schickt beim exit/Schliessen jedem Job seiner Jobtabelle gezielt ein
    # SIGHUP - dagegen hilft setsid allein nicht.
    # Die emerge-Kette laeuft dafuer in einer frischen zsh, die _sysup_sync als
    # Definition mitbekommt; die __SYSUP_STAGE-Marker sagen der Zusammenfassung,
    # an welcher Stufe die Kette abbrach. --with-bdeps/--changed-deps stehen
    # auch in EMERGE_DEFAULT_OPTS, bleiben hier aber explizit, damit sysup nicht
    # still von make.conf abhaengt.
    # eclean-kernel laeuft am Ende der emerge-Kette, weil emerge zuvor evtl. einen
    # neuen Kernel installiert hat. -n 3 = die 3 neuesten behalten; der laufende
    # Kernel wird immer geschuetzt, und ohne -d bleibt alles unangetastet, was
    # GRUB referenziert. Raeumt auch /lib/modules + regeneriert grub.cfg.
    setsid zsh -fc "$(functions _sysup_sync)"'
      _sysup_sync \
        && echo __SYSUP_STAGE=world         && command sudo emerge -uDN --with-bdeps=y --changed-deps=y @world \
        && echo __SYSUP_STAGE=depclean      && command sudo emerge --depclean \
        && echo __SYSUP_STAGE=eclean-kernel && command sudo eclean-kernel -n 3
      rc=$?
      # Leichen in /etc/portage (Eintraege fuer nicht installierte, stabil
      # gewordene oder ungueltige Pakete) nur melden, nie anfassen; aendert
      # den Exit-Code der Kette nicht. LC_ALL=C: eix uebersetzt seine Ausgabe,
      # der Report parst die englischen Ueberschriften.
      if (( $+commands[eix-test-obsolete] )); then
        echo __SYSUP_OBSOLETE_BEGIN__
        command sudo eix-update -q && LC_ALL=C eix-test-obsolete
        echo __SYSUP_OBSOLETE_END__
      fi
      echo "__SYSUP_RC=$rc"' &>"${logs[1]}" &!
    local emerge_pid=$!
    pids+=($emerge_pid)
    setsid flatpak upgrade -y &>"${logs[2]}" &!
    pids+=($!)
    setsid chezmoi update --no-tty &>"${logs[3]}" &!
    local dotfiles_pid=$!
    pids+=($dotfiles_pid)
    setsid $HOME/.local/bin/proton-ge-update &>"${logs[4]}" &!
    pids+=($!)
    # ai wartet auf dotfiles (frisch synchronisierte ai-Skripte + Hermes-Patch)
    # und auf die emerge-Kette, die evtl. gerade ROCm- oder Python-Libs
    # austauscht, gegen die pip baut und media-mcp neu startet.
    setsid zsh -fc 'print "wartet auf emerge + dotfiles ..."
      while kill -0 $1 2>/dev/null || kill -0 $2 2>/dev/null; do sleep 2; done
      exec $HOME/ai/ai-update.sh' _ $emerge_pid $dotfiles_pid &>"${logs[5]}" &!
    pids+=($!)
    _sysup_lock_update $lock $$ $pids
    trap "_sysup_lock_update ${(q)lock} $pids" EXIT
    local lines=$(( ${#names} + 2 ))
    local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0 drawn=0
    tput civis 2>/dev/null
    while true; do
      local all_done=1
      for j in {1..${#pids}}; do
        kill -0 ${pids[$j]} 2>/dev/null && all_done=0 && break
      done
      (( all_done || interrupted )) && break
      (( drawn )) && printf "\033[${lines}A"
      local elapsed=$((SECONDS - start))
      # COLUMNS kann 0 sein (Shell ohne TTY): eine zu negative Laenge in
      # ${…:0:$maxw} ist ein fataler Expansionsfehler, der die Funktion ohne
      # EXIT-Trap abbricht - der Lock bliebe mit lebender Shell-PID stehen.
      local maxw=$(( ${COLUMNS:-80} - 16 )); (( maxw < 20 )) && maxw=20
      local s=${spin:$((i%${#spin})):1}
      printf "\033[K\n"
      printf "\033[K  \033[1;33m%s\033[0m  \033[1msysup\033[0m  \033[2m%dm%02ds\033[0m\n" \
        "$s" $((elapsed/60)) $((elapsed%60))
      for j in {1..${#pids}}; do
        local last=$(tail -1 "${logs[$j]}" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | tr -d '\r')
        if kill -0 ${pids[$j]} 2>/dev/null; then
          printf "\033[K  \033[33m●\033[0m  %-9s \033[2m%s\033[0m\n" "${names[$j]}" "${${last:-(starting...)}:0:$maxw}"
        else
          printf "\033[K  \033[32m✓\033[0m  %-9s \033[2mdone\033[0m\n" "${names[$j]}"
        fi
      done
      printf "\033[K"
      drawn=1; ((i++)); sleep 0.5
      (( interrupted )) && break
    done
    tput cnorm 2>/dev/null
    if (( drawn )); then
      printf "\033[${lines}A"
      for _ in {1..$lines}; do printf "\033[K\n"; done
      printf "\033[${lines}A"
    fi
    # Jobs koennen waehrend des letzten Takts fertig geworden sein - dann ist
    # die Zusammenfassung trotz Strg+C faellig.
    local alive_jobs=0
    for j in {1..${#pids}}; do kill -0 ${pids[$j]} 2>/dev/null && alive_jobs=1; done
    if (( interrupted && alive_jobs )); then
      print -P "%F{yellow}sysup-Anzeige verlassen%f - Jobs laufen im Hintergrund weiter, Logs: ~/.cache/sysup/"
      return 130
    fi
    interrupted=0
    for j in {1..${#names}}; do
      printf "\n\033[1;36m--- %s ---\033[0m\n" "${names[$j]}"
      if [[ "${names[$j]}" == emerge ]]; then
        _sysup_emerge_summary "${logs[$j]}"
      else
        cat "${logs[$j]}"
      fi
    done | tee $summary
    if (( interrupted )); then
      rm -f $summary   # ein Torso saehe aus wie ein echter Report
      print -P "\n%F{yellow}Zusammenfassung abgebrochen%f - Job-Logs bleiben in ~/.cache/sysup/"
      return 130
    fi
    # Die Job-Logs stecken jetzt in der Zusammenfassung; Reste verlassener Laeufe
    # nach einem Tag weg.
    rm -f ${logs[2,-1]}
    local -a stale=( $logdir/emerge-*.log(Nom[11,-1]) $logdir/summary-*.txt(Nom[11,-1])
                     $logdir/(flatpak|dotfiles|proton-ge|ai)-*.log(Nmh+24) )
    (( $#stale )) && rm -f $stale
    printf "\n\033[1;32m✓ Done in %ds\033[0m  \033[2m(Zusammenfassung: %s)\033[0m\n" "$((SECONDS - start))" "$summary"
  } always {
    _sysup_lock_update $lock $pids
    tput cnorm 2>/dev/null
    trap - EXIT   # Lock ist geschrieben; der EXIT-Trap war nur fuer SIGHUP im Rumpf
  }
}
{{- end }}

# Tools (cached init for faster startup)
if [[ ! -s ~/.cache/zsh/zoxide.zsh || ! -s ~/.cache/zsh/starship.zsh ]] || (( $(date +%s) - $(stat -c %Y ~/.cache/zsh/zoxide.zsh 2>/dev/null || echo 0) > 86400 )); then
  mkdir -p ~/.cache/zsh
  zoxide init zsh > ~/.cache/zsh/zoxide.zsh
  starship init zsh > ~/.cache/zsh/starship.zsh
fi
source ~/.cache/zsh/zoxide.zsh
source ~/.cache/zsh/starship.zsh

# Bitwarden CLI
alias bwu='export BW_SESSION=$(bw unlock --raw)'

# fzf: use fd as backend, follow symlinks, respect .gitignore
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# ripgrep config
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# CHROME_BIN (resolved on demand, not every shell start)
export CHROME_BIN="${CHROME_BIN:-$(command -v chromium-browser 2>/dev/null || command -v chromium 2>/dev/null || command -v google-chrome 2>/dev/null)}"
