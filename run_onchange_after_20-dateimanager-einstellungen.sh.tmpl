{{- if eq .distro "gentoo" -}}
#!/bin/sh
# Einstellungen für Nautilus und Nemo (dconf, nicht als Datei verwaltbar).
# Läuft erneut, sobald sich dieses Skript ändert.
S=org.gnome.nautilus.preferences
gsettings set $S default-folder-viewer 'list-view'
gsettings set $S show-delete-permanently true
gsettings set $S show-create-link true
gsettings set $S show-image-thumbnails 'always'
gsettings set $S thumbnail-limit 1024
gsettings set $S click-policy 'double'
gsettings set org.gtk.gtk4.Settings.FileChooser sort-directories-first true
gsettings set org.gnome.nautilus.list-view default-visible-columns "['name', 'size', 'date_modified']"
N=org.nemo.preferences
gsettings set $N default-folder-viewer 'list-view' 2>/dev/null || true
gsettings set $N enable-delete true 2>/dev/null || true
gsettings set $N show-image-thumbnails 'always' 2>/dev/null || true
gsettings set $N sort-directories-first true 2>/dev/null || true
gsettings set org.nemo.desktop show-desktop-icons false 2>/dev/null || true
gsettings set org.cinnamon.desktop.default-applications.terminal exec 'kitty' 2>/dev/null || true
# Aussehen (auch für GTK-Flatpaks über das Settings-Portal)
gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'
gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark-Akzent'
gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Classic'
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.cinnamon.desktop.interface icon-theme 'Papirus-Dark-Akzent' 2>/dev/null || true
gsettings set org.cinnamon.desktop.interface gtk-theme 'adw-gtk3-dark' 2>/dev/null || true
{{- end }}
