#!/usr/bin/env bash
#
# proton-ge-update — installiert das neueste stabile GE-Proton in Steam.
#
# Holt das aktuellste Release von GloriousEggroll/proton-ge-custom, verifiziert
# die sha512-Checksum und entpackt es nach compatibilitytools.d. Ist die neueste
# Version schon installiert, passiert nichts.
#
#   proton-ge-update            # neueste Version installieren (falls neuer)
#   proton-ge-update --cleanup  # danach ältere GE-Proton-Versionen entfernen
#   proton-ge-update --force    # neu installieren, auch wenn bereits vorhanden
#
set -euo pipefail

REPO="GloriousEggroll/proton-ge-custom"
DEST="${HOME}/.steam/root/compatibilitytools.d"

CLEANUP=0
FORCE=0
for arg in "$@"; do
  case "$arg" in
    --cleanup) CLEANUP=1 ;;
    --force)   FORCE=1 ;;
    -h|--help) sed -n '3,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf '\033[1;31mEE\033[0m Unbekannte Option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mEE\033[0m %s\n' "$*" >&2; }

# --- Abhängigkeiten ---------------------------------------------------------
for t in curl tar sha512sum; do
  command -v "$t" >/dev/null || { err "Benötigtes Tool fehlt: $t"; exit 1; }
done

# Fortschrittsbalken nur im Terminal; in Pipe/Logfile (z.B. sysup) still halten.
if [ -t 1 ]; then CURL_PROGRESS=(--progress-bar); else CURL_PROGRESS=(-sS); fi

mkdir -p "$DEST"

# Entfernt alle GE-Proton-Versionen außer der gerade aktuellen ($TAG).
cleanup_old() {
  local d name removed=0
  for d in "${DEST}"/GE-Proton*; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    if [ "$name" != "$TAG" ]; then
      info "Entferne alte Version: ${name}"
      rm -rf "$d"
      removed=1
    fi
  done
  [ "$removed" -eq 0 ] && info "Keine älteren GE-Proton-Versionen zu entfernen."
  return 0   # sonst liefert die &&-Zeile oben 1, sobald etwas entfernt wurde -> set -e bricht ab
}

# --- Neuesten Tag ermitteln (Redirect von /releases/latest, kein API-Limit) -
info "Ermittle neuestes GE-Proton Release ..."
LATEST_URL=$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
  "https://github.com/${REPO}/releases/latest") \
  || { err "GitHub nicht erreichbar."; exit 1; }
TAG="${LATEST_URL##*/}"
case "$TAG" in
  GE-Proton*) : ;;
  *) err "Unerwarteter Release-Tag: '${TAG}'"; exit 1 ;;
esac
info "Neueste Version: ${TAG}"

# --- Schon installiert? -----------------------------------------------------
# Erst die compatibilitytool.vdf macht den Ordner fuer Steam zu einem Tool; ein
# Ordner ohne sie ist ein Rest eines abgebrochenen Laufs und wird ersetzt.
if [ -f "${DEST}/${TAG}/compatibilitytool.vdf" ] && [ "$FORCE" -eq 0 ]; then
  info "${TAG} ist bereits installiert. Nichts zu tun. (--force zum Erzwingen)"
  [ "$CLEANUP" -eq 1 ] && cleanup_old
  exit 0
fi

# --- Download + Verify + Extract --------------------------------------------
TMP=$(mktemp -d)
# Staging auf demselben Dateisystem wie $DEST, damit das abschliessende mv ein
# atomares rename ist. Der fuehrende Punkt haelt es aus dem GE-Proton*-Glob und
# aus Steams Tool-Scan heraus.
STAGE="${DEST}/.${TAG}.partial"
trap 'rm -rf "$TMP" "$STAGE"' EXIT

BASE="https://github.com/${REPO}/releases/download/${TAG}"
# Seit GE-Proton11-4 tragen die Assets die Architektur im Namen
# (GE-Proton11-6-x86_64.tar.gz, Ordner im Archiv ebenso); aeltere Releases
# heissen nur ${TAG}.tar.gz. Den neuen Namen zuerst probieren.
ASSET=""
for cand in "${TAG}-$(uname -m)" "${TAG}"; do
  if curl -fsSLI -o /dev/null "${BASE}/${cand}.tar.gz"; then ASSET="$cand"; break; fi
done
[ -n "$ASSET" ] || { err "Kein passendes Archiv für ${TAG} ($(uname -m)) im Release gefunden."; exit 1; }
TARBALL="${ASSET}.tar.gz"
CHECKSUM="${ASSET}.sha512sum"

info "Lade ${TARBALL} ..."
curl -fSL "${CURL_PROGRESS[@]}" -o "${TMP}/${TARBALL}"  "${BASE}/${TARBALL}"
curl -fsSL                      -o "${TMP}/${CHECKSUM}" "${BASE}/${CHECKSUM}"

info "Prüfe sha512-Checksum ..."
( cd "$TMP" && sha512sum -c "$CHECKSUM" ) \
  || { err "Checksum-Prüfung fehlgeschlagen — Abbruch."; exit 1; }

info "Entpacke nach ${DEST} ..."
rm -rf "$STAGE"; mkdir -p "$STAGE"
tar -xf "${TMP}/${TARBALL}" -C "$STAGE"
# Der Ordnername im Archiv folgt dem Asset-Namen; installiert wird immer unter
# ${TAG}, damit Installiert-Pruefung und --cleanup einheitlich bleiben (Steam
# liest den Anzeigenamen aus der vdf, nicht aus dem Ordnernamen).
mapfile -t VDF < <(find "$STAGE" -mindepth 2 -maxdepth 2 -name compatibilitytool.vdf)
[ "${#VDF[@]}" -eq 1 ] \
  || { err "Archiv enthält nicht genau ein Tool-Verzeichnis mit compatibilitytool.vdf — Abbruch."; exit 1; }
[ -d "${DEST}/${TAG}" ] && rm -rf "${DEST:?}/${TAG}"   # bei --force/Rest sauber ersetzen
mv "$(dirname "${VDF[0]}")" "${DEST}/${TAG}"

info "Installiert: ${TAG}"

# --- Optional: ältere GE-Proton-Versionen entfernen -------------------------
[ "$CLEANUP" -eq 1 ] && cleanup_old

echo
info "Fertig. Steam neu starten, dann unter:"
info "  Spiel → Eigenschaften → Kompatibilität → '${TAG}' auswählen"
info "  (oder global: Steam → Einstellungen → Compatibility)"
