#!/usr/bin/env bash
#
# dms-update — aktualisiert Dux Shell (früher DankMaterialShell, Befehl `dms`)
# und den Login-Bildschirm dms-greeter.
#
# Holt jeweils das neueste Release (duxlabs-dev/dux-shell bzw. dux-greeter;
# die Oberfläche steckt im Programm selbst), prüft die sha256-Summe und
# ersetzt /usr/local/bin/dms bzw. /usr/local/bin/dms-greeter.
# `dms update` taugt dafür nicht: es erkennt die manuelle Installation nicht.
# Ist die neueste Version schon installiert, passiert nichts.
#
#   dms-update           # neueste Version installieren (falls neuer)
#   dms-update --force   # neu installieren, auch wenn schon aktuell
#   dms-update --fonts   # nur Google Sans Flex aus der Shell übernehmen
#   dms-update --no-restart  # laufende Shell nach dem Update nicht neu starten
#
# Läuft die Shell gerade in niri, startet sie nach einem Update neu (über
# dms-start); sonst läuft bis zum nächsten Login die alte Version weiter.
#
# Google Sans Flex (OFL) bringt die Shell nur für sich selbst mit; eine Kopie
# in ~/.local/share/fonts macht sie auch für GTK, Qt und fontconfig nutzbar.
#
set -euo pipefail


FORCE=0; ONLY_FONTS=0; RESTART=1; SHELL_UPDATED=""; SHELL_BIN=/usr/local/bin/dms
for arg in "$@"; do
  case "$arg" in
    --force)      FORCE=1 ;;
    --fonts)      ONLY_FONTS=1 ;;
    --no-restart) RESTART=0 ;;
    -h|--help) sed -n '3,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf '\033[1;31mEE\033[0m Unbekannte Option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31mEE\033[0m %s\n' "$*" >&2; }

for t in curl gunzip sha256sum; do
  command -v "$t" >/dev/null || { err "Benötigtes Tool fehlt: $t"; exit 1; }
done

# update <Name> <Repo> <Asset> <Ziel>
update() {
  local name=$1 repo=$2 asset=$3 dest=$4 url tag cur tmp want have bin
  if [ ! -x "$dest" ]; then
    info "$name ist nicht installiert ($dest fehlt) – übersprungen."
    return 0
  fi
  # Neuester Tag über den Redirect von /releases/latest (kein API-Limit)
  url=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${repo}/releases/latest")
  tag=${url##*/}
  case "$tag" in v[0-9]*) ;; *) err "$name: neueste Version nicht ermittelbar (${url})"; return 1 ;; esac

  cur=$("$dest" version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+[0-9A-Za-z.-]*' | head -1 || true)
  cur=v${cur#v}
  if [ "$cur" = "$tag" ] && [ "$FORCE" -eq 0 ]; then
    info "$name ${cur} ist aktuell."
    return 0
  fi
  info "Aktualisiere $name ${cur:-?} → ${tag} ..."

  tmp=$(mktemp -d)
  if ! curl -fsSL -o "$tmp/$asset" "https://github.com/${repo}/releases/download/${tag}/$asset" \
     || ! curl -fsSL -o "$tmp/$asset.sha256" "https://github.com/${repo}/releases/download/${tag}/$asset.sha256"; then
    err "$name: Download fehlgeschlagen"; rm -rf "$tmp"; return 1
  fi
  # Die .sha256-Datei nennt die Datei teils anders – nur den Hash vergleichen.
  want=$(awk '{print $1; exit}' "$tmp/$asset.sha256")
  have=$(sha256sum "$tmp/$asset" | awk '{print $1}')
  if [ -z "$want" ] || [ "$want" != "$have" ]; then
    err "$name: Prüfsumme stimmt nicht (erwartet ${want:-?}, erhalten ${have}) – nichts ersetzt."
    rm -rf "$tmp"; return 1
  fi
  gunzip "$tmp/$asset"; bin="$tmp/${asset%.gz}"; chmod 755 "$bin"
  "$bin" version >/dev/null 2>&1 || { err "$name: neues Programm startet nicht – nichts ersetzt."; rm -rf "$tmp"; return 1; }
  sudo -n install -m755 "$bin" "$dest"
  rm -rf "$tmp"
  info "Installiert: $name ${tag}"
  [ "$name" = "Dux Shell" ] && SHELL_UPDATED=$tag
  return 0
}

# Die laufende Shell beenden und über dms-start neu starten, damit sie die neue
# Version nutzt. Nur Shells des ersetzten Programms (nicht etwa ein Test-Build
# aus einem anderen Ordner), und nur in niri: von einer Konsole aus gäbe es
# nichts, worin sie starten könnte. Terminals aus der Shell überleben das, sie
# laufen losgelöst von ihr.
restart_shell() {
  local tag=$1 pids kids pid alive starter="$HOME/.local/bin/dms-start"
  local ui="${XDG_DATA_HOME:-$HOME/.local/share}/dux-shell-ui"
  pids=$(pgrep -f "^(${SHELL_BIN}|dms) run( |\$)" || true)
  [ -n "$pids" ] || return 0
  if [ "$RESTART" -eq 0 ] || [ -z "${NIRI_SOCKET:-}" ] || [ ! -x "$starter" ]; then
    printf '  \033[33m!\033[0m Dux Shell läuft noch mit der alten Version – aktiv nach einem Neustart der Shell oder dem nächsten niri-Login\n'
    return 0
  fi
  if [ -f "$ui/shell.qml" ] && [ "$(cat "$ui/VERSION" 2>/dev/null)" != "$tag" ]; then
    printf '  \033[33m!\033[0m Eigene Oberfläche (%s) passt nicht zu %s – es startet die eingebaute\n' "$(cat "$ui/VERSION" 2>/dev/null || echo '?')" "$tag"
  fi
  info "Starte Dux Shell neu ..."
  # `dms run` gibt SIGTERM an die Oberfläche (qs) weiter und endet sofort; erst
  # wenn auch die weg ist, darf die neue starten, sonst sieht sie die alte noch
  # laufen und beendet sich gleich wieder.
  kids=$(for pid in $pids; do pgrep -P "$pid" || true; done)
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  # shellcheck disable=SC2086
  if ! wait_gone $pids $kids; then
    # shellcheck disable=SC2086
    kill -KILL $pids $kids 2>/dev/null || true
    # shellcheck disable=SC2086
    if ! wait_gone $pids $kids; then
      err "Die alte Dux Shell lässt sich nicht beenden – nichts neu gestartet."
      return 1
    fi
  fi
  niri msg action spawn -- "$starter" >/dev/null || { err "Dux Shell ließ sich nicht neu starten – bitte \`dms-start\` ausführen."; return 1; }
}

# wait_gone <PID>… – bis zu 5 s warten, bis alle beendet sind.
wait_gone() {
  local pid alive
  for _ in $(seq 20); do
    alive=0
    for pid in "$@"; do kill -0 "$pid" 2>/dev/null && alive=1; done
    [ "$alive" -eq 0 ] && return 0
    sleep 0.25
  done
  return 1
}

# Google Sans Flex aus der Shell kopieren (nur wenn neu/anders). Die eingebaute
# Shell entpackt sich beim Start nach /run/user/$UID/dms-shell/<hash>/; eine
# eigene Oberfläche (dms-start, ~/.local/share/dux-shell-ui) bringt sie selbst mit.
sync_fonts() {
  local src="" dir dst=${XDG_DATA_HOME:-$HOME/.local/share}/fonts/google-sans-flex
  # Die eigene Oberfläche zuerst: läuft sie, kann unter /run noch eine ältere
  # Entpackung der eingebauten liegen.
  for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/dux-shell-ui/DCommon/assets/fonts/google-sans-flex" \
             $(ls -td /run/user/"$(id -u)"/dms-shell/*/DCommon/assets/fonts/google-sans-flex 2>/dev/null); do
    [ -f "$dir/GoogleSansFlex.ttf" ] && { src=$dir; break; }
  done
  if [ -z "$src" ]; then
    info "Google Sans Flex: keine Shell-Dateien gefunden (Shell nie gestartet?) – übersprungen."; return 0
  fi
  cmp -s "$src/GoogleSansFlex.ttf" "$dst/GoogleSansFlex.ttf" && return 0
  mkdir -p "$dst"
  install -m644 "$src/GoogleSansFlex.ttf" "$src/OFL.txt" "$dst/"
  fc-cache -f "$dst" >/dev/null 2>&1 || true
  info "Google Sans Flex übernommen ($dst)"
}

if [ "$ONLY_FONTS" -eq 1 ]; then sync_fonts; exit 0; fi

rc=0
update "Dux Shell"   duxlabs-dev/dux-shell   dms-cli-amd64.gz            "$SHELL_BIN"               || rc=1
update "dms-greeter" duxlabs-dev/dux-greeter dms-greeter-linux-amd64.gz  /usr/local/bin/dms-greeter || rc=1
if [ -n "$SHELL_UPDATED" ]; then restart_shell "$SHELL_UPDATED" || rc=1; fi
sync_fonts || rc=1
exit $rc
