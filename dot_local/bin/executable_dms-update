#!/usr/bin/env bash
#
# dms-update — aktualisiert Dux Shell (früher DankMaterialShell, Befehl `dms`).
#
# Holt das neueste Release von duxlabs-dev/dux-shell (die Oberfläche steckt im
# Programm selbst), prüft die sha256-Summe und ersetzt /usr/local/bin/dms.
# `dms update` taugt dafür nicht: es erkennt die manuelle Installation nicht.
# Ist die neueste Version schon installiert, passiert nichts.
#
#   dms-update           # neueste Version installieren (falls neuer)
#   dms-update --force   # neu installieren, auch wenn schon aktuell
#
set -euo pipefail

REPO="duxlabs-dev/dux-shell"
DEST="/usr/local/bin/dms"
ASSET="dms-cli-amd64.gz"

FORCE=0
for arg in "$@"; do
  case "$arg" in
    --force)   FORCE=1 ;;
    -h|--help) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf '\033[1;31mEE\033[0m Unbekannte Option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31mEE\033[0m %s\n' "$*" >&2; }

for t in curl gunzip sha256sum; do
  command -v "$t" >/dev/null || { err "Benötigtes Tool fehlt: $t"; exit 1; }
done
if [ ! -x "$DEST" ]; then
  info "Dux Shell ist nicht installiert ($DEST fehlt) – nichts zu tun."
  exit 0
fi

# Neuester Tag über den Redirect von /releases/latest (kein API-Limit)
info "Ermittle neueste Dux-Shell-Version ..."
url=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${REPO}/releases/latest")
TAG=${url##*/}
case "$TAG" in v[0-9]*) ;; *) err "Konnte die neueste Version nicht ermitteln (${url})"; exit 1 ;; esac

CUR=$("$DEST" version 2>/dev/null | grep -oE 'v[0-9][0-9.]*[0-9A-Za-z.-]*' | head -1 || true)
if [ "$CUR" = "$TAG" ] && [ "$FORCE" -eq 0 ]; then
  info "Dux Shell ${CUR} ist aktuell."
  exit 0
fi
info "Aktualisiere Dux Shell ${CUR:-?} → ${TAG} ..."

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
base="https://github.com/${REPO}/releases/download/${TAG}"
curl -fsSL -o "$TMP/$ASSET" "$base/$ASSET"
curl -fsSL -o "$TMP/$ASSET.sha256" "$base/$ASSET.sha256"

# Die .sha256-Datei nennt die Datei teils anders (dms-amd64.gz) – nur den Hash vergleichen.
want=$(awk '{print $1; exit}' "$TMP/$ASSET.sha256")
have=$(sha256sum "$TMP/$ASSET" | awk '{print $1}')
if [ -z "$want" ] || [ "$want" != "$have" ]; then
  err "Prüfsumme stimmt nicht (erwartet ${want:-?}, erhalten ${have}) – nichts ersetzt."
  exit 1
fi

gunzip "$TMP/$ASSET"
chmod 755 "$TMP/${ASSET%.gz}"
"$TMP/${ASSET%.gz}" version >/dev/null 2>&1 || { err "Neues Programm startet nicht – nichts ersetzt."; exit 1; }
sudo -n install -m755 "$TMP/${ASSET%.gz}" "$DEST"
info "Installiert: Dux Shell ${TAG}"

if pgrep -x dms >/dev/null; then
  printf '  \033[33m!\033[0m läuft gerade – aktiv nach `dms restart` oder dem nächsten niri-Login\n'
fi
