#!/usr/bin/env bash
#
# dms-update — aktualisiert Dux Shell (früher DankMaterialShell, Befehl `dms`)
# und den Login-Bildschirm dms-greeter.
#
# Holt jeweils das neueste Release (duxlabs-dev/dux-shell bzw. dux-greeter;
# die Oberfläche steckt im Programm selbst), prüft die sha256-Summe und
# ersetzt /usr/local/bin/dms bzw. /usr/local/bin/dms-greeter.
# `dms update` taugt dafür nicht: es erkennt die manuelle Installation nicht.
# Ist die neueste Version schon installiert, passiert nichts.
#
#   dms-update           # neueste Version installieren (falls neuer)
#   dms-update --force   # neu installieren, auch wenn schon aktuell
#
set -euo pipefail


FORCE=0
for arg in "$@"; do
  case "$arg" in
    --force)   FORCE=1 ;;
    -h|--help) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf '\033[1;31mEE\033[0m Unbekannte Option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31mEE\033[0m %s\n' "$*" >&2; }

for t in curl gunzip sha256sum; do
  command -v "$t" >/dev/null || { err "Benötigtes Tool fehlt: $t"; exit 1; }
done

# update <Name> <Repo> <Asset> <Ziel>
update() {
  local name=$1 repo=$2 asset=$3 dest=$4 url tag cur tmp want have bin
  if [ ! -x "$dest" ]; then
    info "$name ist nicht installiert ($dest fehlt) – übersprungen."
    return 0
  fi
  # Neuester Tag über den Redirect von /releases/latest (kein API-Limit)
  url=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${repo}/releases/latest")
  tag=${url##*/}
  case "$tag" in v[0-9]*) ;; *) err "$name: neueste Version nicht ermittelbar (${url})"; return 1 ;; esac

  cur=$("$dest" version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+[0-9A-Za-z.-]*' | head -1 || true)
  cur=v${cur#v}
  if [ "$cur" = "$tag" ] && [ "$FORCE" -eq 0 ]; then
    info "$name ${cur} ist aktuell."
    return 0
  fi
  info "Aktualisiere $name ${cur:-?} → ${tag} ..."

  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/$asset" "https://github.com/${repo}/releases/download/${tag}/$asset" \
    && curl -fsSL -o "$tmp/$asset.sha256" "https://github.com/${repo}/releases/download/${tag}/$asset.sha256" \
    || { err "$name: Download fehlgeschlagen"; rm -rf "$tmp"; return 1; }
  # Die .sha256-Datei nennt die Datei teils anders – nur den Hash vergleichen.
  want=$(awk '{print $1; exit}' "$tmp/$asset.sha256")
  have=$(sha256sum "$tmp/$asset" | awk '{print $1}')
  if [ -z "$want" ] || [ "$want" != "$have" ]; then
    err "$name: Prüfsumme stimmt nicht (erwartet ${want:-?}, erhalten ${have}) – nichts ersetzt."
    rm -rf "$tmp"; return 1
  fi
  gunzip "$tmp/$asset"; bin="$tmp/${asset%.gz}"; chmod 755 "$bin"
  "$bin" version >/dev/null 2>&1 || { err "$name: neues Programm startet nicht – nichts ersetzt."; rm -rf "$tmp"; return 1; }
  sudo -n install -m755 "$bin" "$dest"
  rm -rf "$tmp"
  info "Installiert: $name ${tag}"
  if [ "$name" = "Dux Shell" ] && pgrep -x dms >/dev/null; then
    printf '  \033[33m!\033[0m läuft gerade – aktiv nach `dms restart` oder dem nächsten niri-Login\n'
  fi
}

rc=0
update "Dux Shell"   duxlabs-dev/dux-shell   dms-cli-amd64.gz            /usr/local/bin/dms         || rc=1
update "dms-greeter" duxlabs-dev/dux-greeter dms-greeter-linux-amd64.gz  /usr/local/bin/dms-greeter || rc=1
exit $rc
