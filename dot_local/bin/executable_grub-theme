#!/usr/bin/env bash
#
# grub-theme — baut das GRUB-Theme „battlestation“ aus dem aktuellen
# DMS-Hintergrundbild und den DMS-Farben (matugen) und installiert es nach
# /boot/grub/themes/battlestation. Beim ersten Mal wird GRUB_THEME in
# /etc/default/grub gesetzt und grub.cfg neu erzeugt.
#
#   grub-theme            # Theme (neu) bauen und installieren
#   grub-theme --dry-run  # nur bauen, Ergebnis-Ordner ausgeben
#
set -euo pipefail

DEST=/boot/grub/themes/battlestation
DRY=0; [ "${1:-}" = --dry-run ] && DRY=1

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31mEE\033[0m %s\n' "$*" >&2; }
for t in ffmpeg grub-mkfont rsvg-convert jq; do
  command -v "$t" >/dev/null || { err "Benötigtes Tool fehlt: $t"; exit 1; }
done

# --- Hintergrund und Farben aus DMS -----------------------------------------
WALL=$(jq -r '.wallpaperPath // empty' "${XDG_STATE_HOME:-$HOME/.local/state}/dms/session.json" 2>/dev/null || true)
[ -f "${WALL:-}" ] || { err "Kein DMS-Hintergrundbild gefunden"; exit 1; }
COLORS="${XDG_CACHE_HOME:-$HOME/.cache}/dms/dms-colors.json"
col() { jq -r --arg k "$1" '(.colors.dark // .)[$k] // empty' "$COLORS"; }
PRIMARY=$(col primary);           PRIMARY=${PRIMARY:-#ffacec}
ON_PRIMARY=$(col on_primary);     ON_PRIMARY=${ON_PRIMARY:-#5d0056}
ON_SURFACE=$(col on_surface);     ON_SURFACE=${ON_SURFACE:-#f1dde8}
MUTED=$(col on_surface_variant);  MUTED=${MUTED:-#d4c2cc}
TRACK=$(col surface_container_high); TRACK=${TRACK:-#32272f}

# nur neu bauen, wenn sich Hintergrund oder Akzentfarbe geändert haben
STAMP="$(sha256sum "$WALL" | cut -c1-16)-$PRIMARY"
if [ "$DRY" -eq 0 ] && [ "$(cat "$DEST/.quelle" 2>/dev/null)" = "$STAMP" ] \
   && grep -q "^GRUB_THEME=\"$DEST/theme.txt\"" /etc/default/grub; then
  info "GRUB-Theme ist aktuell."; exit 0
fi

W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
T="$W/battlestation"; mkdir -p "$T/icons"
echo "$STAMP" > "$T/.quelle"

info "Hintergrund: $(basename "$WALL")"
# auf 1920x1080 zuschneiden, leicht abdunkeln (Menü bleibt lesbar)
ffmpeg -loglevel error -y -i "$WALL" \
  -vf "scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080,eq=brightness=-0.10:saturation=1.05" \
  -q:v 3 "$T/background.jpg"

# Auswahlbalken (9-Teil-Grafik von GRUB; nur Mitte + Seiten = Rechteck)
hexa() { printf '0x%s@%s' "${1#\#}" "$2"; }
for p in c w e; do
  ffmpeg -loglevel error -y -f lavfi -i "color=c=$(hexa "$PRIMARY" 0.92):s=8x8" \
    -frames:v 1 -pix_fmt rgba "$T/select_$p.png"
done

# Symbole je Menü-Klasse (--class gentoo / windows / gnu-linux …)
P=/usr/share/icons/Papirus
rsvg-convert -w 48 -h 48 "$P/48x48/apps/distributor-logo-gentoo.svg" -o "$T/icons/gentoo.png"
cp "$T/icons/gentoo.png" "$T/icons/gnu-linux.png"
rsvg-convert -w 48 -h 48 "$P/64x64/apps/distributor-logo-windows.svg" -o "$T/icons/windows.png"

# Schriften (GRUB braucht eigenes .pf2-Format)
NOTO=/usr/share/fonts/noto
FIRA=$(fc-match -f '%{file}' 'FiraCode Nerd Font:style=SemiBold')
# nur die nötigen Zeichen (Latein inkl. Umlaute, Pfeile, Punkt) – sonst wird
# die Nerd-Font-Datei 2 MB gross und GRUB lädt beim Start spürbar länger
R=0x20-0x7E,0xA0-0x17F,0x2022-0x2022,0x2190-0x2193
grub-mkfont -r $R -s 16 -o "$T/noto-16.pf2" "$NOTO/NotoSans-Regular.ttf" 2>/dev/null
grub-mkfont -r $R -s 24 -o "$T/noto-24.pf2" "$NOTO/NotoSans-Regular.ttf" 2>/dev/null
grub-mkfont -r $R -s 44 -o "$T/fira-44.pf2" "$FIRA" 2>/dev/null
F16=$(head -c 200 "$T/noto-16.pf2" | tr -c '[:print:]' '\n' | grep -m1 -E 'Regular 16|Noto')
F24=$(head -c 200 "$T/noto-24.pf2" | tr -c '[:print:]' '\n' | grep -m1 -E 'Regular 24|Noto')
F44=$(head -c 200 "$T/fira-44.pf2" | tr -c '[:print:]' '\n' | grep -m1 -E '44|Fira')

cat > "$T/theme.txt" <<EOF
# GRUB-Theme „battlestation“ – erzeugt von ~/.local/bin/grub-theme
# Hintergrund: $(basename "$WALL"), Akzent: $PRIMARY
title-text: ""
desktop-image: "background.jpg"
desktop-image-scale-method: "crop"
desktop-color: "#000000"
terminal-font: "$F16"
terminal-left: "10%"
terminal-top: "10%"
terminal-width: "80%"
terminal-height: "80%"

+ label {
    left = 0
    top = 20%
    width = 100%
    align = "center"
    text = "Battlestation"
    font = "$F44"
    color = "$PRIMARY"
}

+ boot_menu {
    left = 32%
    top = 34%
    width = 36%
    height = 40%
    item_font = "$F24"
    item_color = "$ON_SURFACE"
    selected_item_font = "$F24"
    selected_item_color = "$ON_PRIMARY"
    selected_item_pixmap_style = "select_*.png"
    icon_width = 32
    icon_height = 32
    item_icon_space = 18
    item_height = 52
    item_padding = 14
    item_spacing = 10
    scrollbar = false
}

+ progress_bar {
    id = "__timeout__"
    left = 38%
    top = 80%
    width = 24%
    height = 6
    fg_color = "$PRIMARY"
    bg_color = "$TRACK"
    border_color = "$TRACK"
    show_text = false
}

+ label {
    id = "__timeout__"
    left = 0
    top = 82%
    width = 100%
    align = "center"
    text = "Start in %d s"
    font = "$F16"
    color = "$MUTED"
}

+ label {
    left = 0
    top = 92%
    width = 100%
    align = "center"
    text = "↑ ↓ auswählen   •   Enter starten   •   e bearbeiten   •   c Konsole"
    font = "$F16"
    color = "$MUTED"
}
EOF

if [ "$DRY" -eq 1 ]; then
  cp -r "$T" /tmp/grub-theme-preview && info "Gebaut: /tmp/grub-theme-preview"; exit 0
fi

sudo -n rm -rf "$DEST.new" && sudo -n cp -r "$T" "$DEST.new" \
  && sudo -n rm -rf "$DEST" && sudo -n mv "$DEST.new" "$DEST"
info "Installiert: $DEST"

if ! grep -q "^GRUB_THEME=\"$DEST/theme.txt\"" /etc/default/grub; then
  sudo -n sed -i "s|^GRUB_THEME=.*|GRUB_THEME=\"$DEST/theme.txt\"|" /etc/default/grub
  grep -q '^GRUB_THEME=' /etc/default/grub || echo "GRUB_THEME=\"$DEST/theme.txt\"" | sudo -n tee -a /etc/default/grub >/dev/null
  sudo -n grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 && info "grub.cfg neu erzeugt"
fi
