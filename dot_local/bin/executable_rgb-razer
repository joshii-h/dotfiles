#!/usr/bin/env python3
"""rgb-razer — setzt Razer-Geräte (OpenRazer) auf die Akzentfarbe des Hintergrundbilds.

Läuft als matugen-post_hook bei jedem Farbwechsel. Die übrigen LEDs (Tastatur,
RAM, Lüfter, Mainboard) färbt das DMS-Plugin „OpenRGB Theme Sync“ mit derselben
Farbe (Theme.primary). Setzt jede Leuchtzone einzeln (Logo, Mausrad, links/rechts),
weil z. B. die Basilisk Ultimate keinen gemeinsamen Effekt kennt.

  rgb-razer            # Farbe aus ~/.cache/matugen/akzent
  rgb-razer ff00aa     # feste Farbe
"""
import os
import re
import sys

src = sys.argv[1] if len(sys.argv) > 1 else ""
if not src:
    cache = os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))
    try:
        src = open(os.path.join(cache, "matugen/akzent")).read()
    except OSError:
        sys.exit(0)
m = re.fullmatch(r"#?([0-9a-fA-F]{6})", src.strip())
if not m:
    sys.exit("Ungültige Farbe: " + src.strip())
r, g, b = (int(m.group(1)[i:i + 2], 16) for i in (0, 2, 4))

try:
    from openrazer.client import DeviceManager
    devices = DeviceManager().devices
except Exception:
    sys.exit(0)  # kein Daemon/keine Geräte: nichts zu tun

for d in devices:
    caps = d.capabilities
    try:
        if caps.get("lighting_static"):
            d.fx.static(r, g, b)
        if caps.get("brightness"):
            d.brightness = 100
        for zone in ("logo", "scroll", "left", "right", "backlight"):
            if not caps.get(f"lighting_{zone}_static"):
                continue
            obj = getattr(d.fx.misc, "scroll_wheel" if zone == "scroll" else zone)
            obj.static(r, g, b)
            if caps.get(f"lighting_{zone}_brightness"):
                obj.brightness = 100
    except Exception as e:  # ein Gerät im Standby soll die anderen nicht blockieren
        print(f"{d.name}: {e}", file=sys.stderr)
