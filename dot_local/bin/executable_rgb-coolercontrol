#!/usr/bin/env python3
"""rgb-coolercontrol — färbt alle LED-Geräte in CoolerControl ein (H150i, Lighting Node
Core, Mainboard-RGB Gigabyte RGB Fusion 2.0).

CoolerControl (liquidctl) steuert diese Geräte schon (Pumpe, Lüfter, LEDs);
OpenRGB parallel darauf zuzugreifen gäbe USB-Konflikte. Deshalb setzt dieses
Skript per REST-API jeden LED-Kanal mit Modus „fixed“ auf die Akzentfarbe.
Läuft als matugen-post_hook bei jedem Farbwechsel.

Zugang: Access-Token aus der CoolerControl-Web-UI (localhost:11987) in
~/.config/coolercontrol/token (chmod 600).

  rgb-coolercontrol            # Farbe aus ~/.cache/matugen/akzent
  rgb-coolercontrol ff00aa     # feste Farbe
  rgb-coolercontrol --list     # LED-Kanäle anzeigen
"""
import json
import os
import re
import sys
import urllib.request

API = "http://localhost:11987"
cfg = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
cache = os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))
try:
    TOKEN = open(os.path.join(cfg, "coolercontrol/token")).read().strip()
except OSError:
    sys.exit("Kein CoolerControl-Token in ~/.config/coolercontrol/token")


def call(method, path, body=None):
    req = urllib.request.Request(API + path, method=method,
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": "Bearer " + TOKEN,
                                          "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as r:
        raw = r.read()
        return json.loads(raw) if raw else None


# LED-Kanäle aller Geräte mit Modus „fixed“
targets = []
for dev in call("GET", "/devices").get("devices", []):
    for ch, info in (dev.get("info") or {}).get("channels", {}).items():
        modes = [m.get("name") for m in (info or {}).get("lighting_modes") or []]
        if "fixed" in modes:
            targets.append((dev["uid"], dev["name"], ch))

if "--list" in sys.argv:
    for _, name, ch in targets:
        print(f"{name}: {ch}")
    sys.exit(0)

src = sys.argv[1] if len(sys.argv) > 1 else open(os.path.join(cache, "matugen/akzent")).read()
m = re.fullmatch(r"#?([0-9a-fA-F]{6})", src.strip())
if not m:
    sys.exit("Ungültige Farbe: " + src.strip())
rgb = [int(m.group(1)[i:i + 2], 16) for i in (0, 2, 4)]

rc = 0
for uid, name, ch in targets:
    try:
        call("PUT", f"/devices/{uid}/settings/{ch}/lighting", {"mode": "fixed", "colors": [rgb]})
    except Exception as e:
        print(f"{name}/{ch}: {e}", file=sys.stderr)
        rc = 1
sys.exit(rc)
