#!/usr/bin/env bash
#
# startbild — baut den Plymouth-Startbildschirm „startbild“ aus dem aktuellen
# Hintergrundbild und dessen Farben (matugen, wie DMS) und macht ihn zum
# Standard. Hintergrund abgedunkelt und weichgezeichnet, in der Mitte das
# Fedora-Logo in der Akzentfarbe, darunter ein drehender Ring.
#
# Hintergrund: DMS (niri), sonst der Plasma-Hintergrund, sonst Fedoras
# Standardbild. Farben: DMS (dms-colors.json), sonst matugen aus dem Bild.
# Baut und installiert nur, wenn sich Bild, Farben oder dieses Skript geändert
# haben – das Initramfs wird dabei neu erzeugt (dauert etwas).
#
#   startbild            # Theme (neu) bauen und installieren
#   startbild --force    # auch bauen, wenn nichts geändert hat
#   startbild --preview  # nur Vorschau-PNG bauen, nichts installieren
#
set -euo pipefail

NAME=startbild
DEST=/usr/share/plymouth/themes/$NAME
FORCE=0; PREVIEW=0
for arg in "$@"; do
  case "$arg" in
    --force)   FORCE=1 ;;
    --preview) PREVIEW=1 ;;
    -h|--help) sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf '\033[1;31mEE\033[0m Unbekannte Option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31mEE\033[0m %s\n' "$*" >&2; }
for t in magick jq matugen plymouth-set-default-theme; do
  command -v "$t" >/dev/null || { err "Benötigtes Tool fehlt: $t"; exit 1; }
done
[ -e /usr/lib64/plymouth/script.so ] || { err "plymouth-plugin-script fehlt"; exit 1; }

# --- Hintergrundbild ---------------------------------------------------------
# Plasma-Hintergründe sind Ordner mit mehreren Grössen: die nehmen, deren
# Seitenverhältnis dem Bildschirm (16:10) am nächsten kommt.
plasma_wall() {
  local img dir best="" bestd=99
  img=$(grep -h '^Image=' "${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null | head -1)
  img=${img#Image=}; img=${img#file://}
  [ -n "$img" ] || return 1
  if [ -d "$img" ]; then
    dir="$img/contents/images"
    for f in "$dir"/*; do
      [[ $(basename "$f") =~ ^([0-9]+)x([0-9]+)\. ]] || continue
      d=$(awk -v w="${BASH_REMATCH[1]}" -v h="${BASH_REMATCH[2]}" 'BEGIN{d=w/h-1.6; print (d<0?-d:d)}')
      awk -v a="$d" -v b="$bestd" 'BEGIN{exit !(a<b)}' && { best=$f; bestd=$d; }
    done
    [ -n "$best" ] && echo "$best"
  else
    [ -f "$img" ] && echo "$img"
  fi
}

SRC=""
WALL=$(jq -r '.wallpaperPath // empty' "${XDG_STATE_HOME:-$HOME/.local/state}/dms/session.json" 2>/dev/null || true)
if [ -f "${WALL:-}" ]; then SRC=dms
else
  WALL=$(plasma_wall || true)
  if [ -f "${WALL:-}" ]; then SRC=plasma; else WALL=/usr/share/backgrounds/default.png; SRC=fedora; fi
fi
[ -f "$WALL" ] || { err "Kein Hintergrundbild gefunden"; exit 1; }

# --- Farben ------------------------------------------------------------------
COLORS="${XDG_CACHE_HOME:-$HOME/.cache}/dms/dms-colors.json"
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
if [ "$SRC" = dms ] && [ -s "$COLORS" ]; then
  col() { jq -r --arg k "$1" '(.colors.dark // .)[$k] // empty' "$COLORS"; }
else
  matugen image "$WALL" --dry-run -j hex -m dark >"$W/m.json" 2>/dev/null || true
  col() { jq -r --arg k "$1" '.colors[$k].dark // empty' "$W/m.json" 2>/dev/null; }
fi
PRIMARY=$(col primary);        PRIMARY=${PRIMARY:-#b0c6ff}
ON_PRIMARY=$(col on_primary);  ON_PRIMARY=${ON_PRIMARY:-#152e60}
ON_SURFACE=$(col on_surface);  ON_SURFACE=${ON_SURFACE:-#e2e2e9}
SURFACE=$(col surface);        SURFACE=${SURFACE:-#111318}

# nur neu bauen, wenn sich Bild, Farben oder das Skript geändert haben
STAMP="$(sha256sum "$WALL" | cut -c1-16)-$PRIMARY-$(sha256sum "$0" | cut -c1-8)"
if [ "$PREVIEW" -eq 0 ] && [ "$FORCE" -eq 0 ] \
   && [ "$(cat "$DEST/.quelle" 2>/dev/null)" = "$STAMP" ] \
   && [ "$(plymouth-set-default-theme)" = "$NAME" ]; then
  info "Startbildschirm ist aktuell."; exit 0
fi

T="$W/$NAME"; mkdir -p "$T"
echo "$STAMP" > "$T/.quelle"
info "Hintergrund ($SRC): $(basename "$WALL"), Akzent $PRIMARY"

# Hintergrund: 2880x1800 füllend zuschneiden, weichzeichnen, abdunkeln und
# zum Rand hin leicht in die Flächenfarbe auslaufen lassen
magick "$WALL" -resize 1440x900^ -gravity center -extent 1440x900 \
  -blur 0x14 -resize 2880x1800 -modulate 62,110 \
  \( -size 2880x1800 radial-gradient:none-"$SURFACE" -alpha set -channel A -evaluate multiply 0.75 +channel \) \
  -composite -quality 92 "$T/background.png"

# Logo: Fedora-Sprechblase in der Akzentfarbe, das „f“ in on_primary
sed -e "s/fill:#51a2da/fill:$PRIMARY/" -e "s/fill:#fafafa/fill:$ON_PRIMARY/" \
  /usr/share/pixmaps/fedora-logo-sprite.svg > "$W/logo.svg"
magick -background none -density 600 "$W/logo.svg" -resize 512x512 "$T/logo.png"

# Ring: 300°-Bogen, der zum Ende hin ausblendet (dreht sich im Skript)
read -r PR PG PB < <(printf '%d %d %d\n' "0x${PRIMARY:1:2}" "0x${PRIMARY:3:2}" "0x${PRIMARY:5:2}")
draw=""
for i in $(seq 0 49); do
  a0=$(( i * 6 )); a1=$(( a0 + 7 ))
  alpha=$(awk -v i="$i" 'BEGIN{printf "%.3f", (i/49)^1.6}')
  draw+="stroke rgba($PR,$PG,$PB,$alpha) arc 24,24 232,232 $a0,$a1 "
done
magick -size 256x256 xc:none -fill none -strokewidth 14 -draw "$draw" "$T/ring.png"

# Farben als 0..1 für Image.Text im Skript
rgbf() { printf '%s, %s, %s' \
  "$(awk -v x=$((0x${1:1:2})) 'BEGIN{printf "%.3f", x/255}')" \
  "$(awk -v x=$((0x${1:3:2})) 'BEGIN{printf "%.3f", x/255}')" \
  "$(awk -v x=$((0x${1:5:2})) 'BEGIN{printf "%.3f", x/255}')"; }

cat > "$T/$NAME.plymouth" <<EOF
[Plymouth Theme]
Name=Startbild
Description=Hintergrundbild + Akzentfarbe (erzeugt von ~/.local/bin/startbild)
ModuleName=script

[script]
ImageDir=$DEST
ScriptFile=$DEST/$NAME.script
Font=Google Sans Flex 13
EOF

cat > "$T/$NAME.script" <<EOF
# Startbild – erzeugt von ~/.local/bin/startbild (nicht von Hand ändern)
# Hintergrund: $(basename "$WALL"), Akzent: $PRIMARY

Window.SetBackgroundTopColor($(rgbf "$SURFACE"));
Window.SetBackgroundBottomColor($(rgbf "$SURFACE"));

sw = Window.GetWidth();
sh = Window.GetHeight();
ox = Window.GetX();
oy = Window.GetY();

# Hintergrund füllend skalieren
bg = Image("background.png");
f = Math.Max(sw / bg.GetWidth(), sh / bg.GetHeight());
bg = bg.Scale(bg.GetWidth() * f, bg.GetHeight() * f);
bgs = Sprite(bg);
bgs.SetPosition(ox + (sw - bg.GetWidth()) / 2, oy + (sh - bg.GetHeight()) / 2, -10);

# Logo (11 % der Bildschirmhöhe) etwas über der Mitte
ls = Math.Int(sh * 0.11);
logo = Image("logo.png").Scale(ls, ls);
logos = Sprite(logo);
logos.SetPosition(ox + (sw - ls) / 2, oy + sh * 0.43 - ls / 2, 10);

# Ring darunter
rs = Math.Int(sh * 0.05);
ring = Image("ring.png").Scale(rs, rs);
rings = Sprite();
rings.SetPosition(ox + (sw - rs) / 2, oy + sh * 0.585 - rs / 2, 10);

t = 0;
fun refresh() {
  t++;
  a = Math.Min(t / 40, 1);
  bgs.SetOpacity(a);
  logos.SetOpacity(a);
  rings.SetImage(ring.Rotate(t * 0.09));
  rings.SetOpacity(a);
}
Plymouth.SetRefreshFunction(refresh);

# Meldungen (z. B. Dateisystemprüfung) unten
msg = Sprite();
msg.SetPosition(ox, oy + sh * 0.88, 20);
fun message(text) {
  img = Image.Text(text, $(rgbf "$ON_SURFACE"), 0.85, "Google Sans Flex 13");
  msg.SetImage(img);
  msg.SetX(ox + (sw - img.GetWidth()) / 2);
}
Plymouth.SetMessageFunction(message);

# Passwortabfrage (z. B. verschlüsselte Platte): Text + Punkte unter dem Logo
pprompt = Sprite();
pbullets = Sprite();
fun password(prompt, bullets) {
  rings.SetOpacity(0);
  p = Image.Text(prompt, $(rgbf "$ON_SURFACE"), 1, "Google Sans Flex 13");
  pprompt.SetImage(p);
  pprompt.SetPosition(ox + (sw - p.GetWidth()) / 2, oy + sh * 0.60, 20);
  s = "";
  for (i = 0; i < bullets; i++) s += "●  ";
  if (bullets == 0) s = " ";
  b = Image.Text(s, $(rgbf "$PRIMARY"), 1, "Google Sans Flex 18");
  pbullets.SetImage(b);
  pbullets.SetPosition(ox + (sw - b.GetWidth()) / 2, oy + sh * 0.65, 20);
}
Plymouth.SetDisplayPasswordFunction(password);

fun normal() {
  pprompt.SetOpacity(0);
  pbullets.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal);
EOF

# Vorschau (gleicher Aufbau wie das Skript, 1440x900)
magick "$T/background.png" -resize 1440x900 \
  \( "$T/logo.png" -resize 99x99 \) -gravity north -geometry +0+337 -composite \
  \( "$T/ring.png" -resize 45x45 \) -gravity north -geometry +0+504 -composite \
  "$W/preview.png"
if [ "$PREVIEW" -eq 1 ]; then
  out="${XDG_CACHE_HOME:-$HOME/.cache}/startbild-vorschau.png"
  cp "$W/preview.png" "$out"; info "Vorschau: $out"; exit 0
fi

sudo -n rm -rf "$DEST.new" && sudo -n cp -r "$T" "$DEST.new" \
  && sudo -n rm -rf "$DEST" && sudo -n mv "$DEST.new" "$DEST"
cp "$W/preview.png" "${XDG_CACHE_HOME:-$HOME/.cache}/startbild-vorschau.png"
info "Installiert: $DEST"
info "Setze Standard-Theme und erzeuge das Initramfs neu ..."
sudo -n plymouth-set-default-theme -R "$NAME" >/dev/null
info "Fertig – sichtbar beim nächsten Start."
