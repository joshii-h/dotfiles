#!/usr/bin/env python3
"""geraete-akkus — Akkustand kabelloser Geräte als JSON (für das DMS-Plugin „Geräteakkus“).

Quellen, die UPower nicht kennt:
  - Razer über OpenRazer
  - Headsets über headsetcontrol (z. B. Astro A50)
iPhone und Bluetooth-Geräte liest das Plugin direkt aus UPower.

Ausgabe: [{"name", "icon", "percent", "charging", "source"}]
"""
import json
import shutil
import subprocess

out = []


def run(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=8)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


# Razer über OpenRazer (openrazer-daemon)
try:
    from openrazer.client import DeviceManager
    razer = list(DeviceManager().devices)
except Exception:
    razer = []
for d in razer:
    try:
        if not d.capabilities.get("battery"):
            continue
        typ = str(d.type).lower()
        out.append({
            "name": d.name.replace(" (Receiver)", ""),
            "icon": "mouse" if "mouse" in typ else ("keyboard" if "keyboard" in typ else "devices"),
            "percent": round(d.battery_level),
            "charging": bool(d.is_charging),
            "source": "openrazer",
        })
    except Exception:
        pass  # Maus schläft oder ist ausgeschaltet

# Headsets über headsetcontrol
if shutil.which("headsetcontrol"):
    try:
        data = json.loads(run(["headsetcontrol", "-b", "-o", "json"]) or "{}")
    except json.JSONDecodeError:
        data = {}
    for d in data.get("devices", []):
        b = d.get("battery") or {}
        status = b.get("status", "")
        if status not in ("BATTERY_AVAILABLE", "BATTERY_CHARGING"):
            continue
        out.append({
            "name": d.get("device") or d.get("product") or "Headset",
            "icon": "headphones",
            "percent": int(b.get("level", 0)),
            "charging": status == "BATTERY_CHARGING",
            "source": "headsetcontrol",
        })

print(json.dumps(out, ensure_ascii=False))
